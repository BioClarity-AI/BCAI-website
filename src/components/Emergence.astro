---
/**
 * The hero's live simulation. The canvas is decorative — every claim it
 * illustrates is also stated in the copy beside it — so it carries aria-hidden
 * and the page reads correctly without it.
 *
 * Animation parameters ride on data attributes so they can be retuned without
 * touching the script.
 */
interface Props {
  speed?: number;
  holdTime?: number;
  linkStrength?: number;
  mouseForce?: number;
  mono?: boolean;
}

const {
  speed = 1.3,
  holdTime = 3.8,
  linkStrength = 1,
  mouseForce = 0.5,
  mono = false,
} = Astro.props;
---

<div
  class="emergence"
  data-emergence
  data-speed={String(speed)}
  data-hold-time={String(holdTime)}
  data-link-strength={String(linkStrength)}
  data-mouse-force={String(mouseForce)}
  data-mono={String(mono)}
>
  <canvas data-canvas aria-hidden="true"></canvas>

  <div class="overlay">
    <p class="kicker">Emergence — live</p>
    <p class="readout" data-readout aria-live="off">INITIALIZING</p>

    <div class="controls">
      <button type="button" data-prev title="Previous view" aria-label="Previous view">←</button>
      <button type="button" data-next title="Next view" aria-label="Next view">→</button>
      <span class="sep" aria-hidden="true"></span>
      <button type="button" data-lock class="lock" title="Lock this view" aria-pressed="false">
        <span class="lock-dot" data-lock-dot aria-hidden="true"></span>
        <span data-lock-label>Lock</span>
      </button>
    </div>
  </div>
</div>

<style>
  .emergence {
    position: relative;
    overflow: hidden;
    min-width: 0;
  }

  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .overlay {
    position: absolute;
    top: 28px;
    left: 32px;
    pointer-events: none;
  }

  .kicker {
    margin: 0;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
  }

  .readout {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 30px;
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 6px 0 0;
    color: var(--color-accent);
  }

  .controls {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
    pointer-events: auto;
    color: var(--color-neutral-600);
  }

  .controls button {
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 15px;
    line-height: 1;
    color: inherit;
  }

  .controls button:hover {
    color: var(--color-accent);
  }

  .sep {
    width: 1px;
    height: 11px;
    background: var(--color-divider);
  }

  .lock {
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-heading) !important;
    font-weight: 800;
    font-size: 10px !important;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .lock-dot {
    width: 5px;
    height: 5px;
    background: transparent;
    border: 1px solid currentColor;
  }

  @media (max-width: 900px) {
    .overlay {
      top: 20px;
      left: 20px;
    }
    .readout {
      font-size: 22px;
    }
  }
</style>

<script>
  import { initEmergence } from '../scripts/emergence';

  document
    .querySelectorAll<HTMLElement>('[data-emergence]')
    .forEach((el) => initEmergence(el));
</script>
