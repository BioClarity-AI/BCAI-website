---
/**
 * Site header. Links point at real routes only — a nav item that 404s costs
 * crawl budget and looks broken, so new items land here when their page does.
 *
 * Services and Science carry a menu of the sections on their page. Clicking one
 * while already on that page must not reload it: the click is handed to the
 * running canvas panel as an event instead, which scrolls the section into view
 * and switches the scene. The href stays a real deep link so it works from any
 * other page, and without JavaScript.
 */
interface MenuItem {
  href: string;
  title: string;
  blurb: string;
  /** Index the page's panel uses to select the matching scene. */
  index: number;
}

interface NavItem {
  href: string;
  label: string;
  /** `hash` is the deep-link prefix the page's sections use: #svc-1, #sci-2. */
  menu?: { event: string; hash: string; items: MenuItem[] };
}

const links: NavItem[] = [
  {
    href: '/services',
    label: 'Services',
    menu: {
      event: 'bcai:service',
      hash: 'svc',
      items: [
        {
          href: '/services#svc-1',
          title: 'AI Adoption Strategy',
          blurb: 'Identify where AI can create measurable value.',
          index: 1,
        },
        {
          href: '/services#svc-2',
          title: 'Validation & Benchmarking',
          blurb: 'Prove what works for your science.',
          index: 2,
        },
        {
          href: '/services#svc-3',
          title: 'AI & Data Products',
          blurb: 'Build around your data, workflows, and portfolio.',
          index: 3,
        },
        {
          href: '/services#svc-4',
          title: 'Portfolio Intelligence',
          blurb: 'Turn complex evidence into better R&D decisions.',
          index: 4,
        },
      ],
    },
  },
  {
    href: '/science',
    label: 'Science',
    menu: {
      event: 'bcai:science',
      hash: 'sci',
      items: [
        {
          href: '/science#sci-1',
          title: 'Platform',
          blurb: 'One layer between model and decision.',
          index: 1,
        },
        {
          href: '/science#sci-2',
          title: 'Why Generalizability Metrics',
          blurb: 'Whether the AI actually learns biology.',
          index: 2,
        },
      ],
    },
  },
  { href: '/company', label: 'Company' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="nav-bar" data-site-nav>
  <a class="brand" href="/">
    <span class="brand-name">BioClarity AI</span>
    <span class="brand-tag" data-brand-tag>Vendor Agnostic AI</span>
  </a>

  <nav class="nav-links" aria-label="Primary">
    {
      links.map(({ href, label, menu }) =>
        menu ? (
          <div class="menu">
            <a class="nav-link" href={href} aria-current={path === href ? 'page' : undefined}>
              {label}
            </a>
            <div class="menu-panel">
              {menu.items.map((item) => (
                <a
                  href={item.href}
                  data-pick={menu.event}
                  data-pick-hash={menu.hash}
                  data-pick-index={item.index}
                  data-pick-path={href}
                >
                  <span class="menu-title">{item.title}</span>
                  <span class="menu-blurb">{item.blurb}</span>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a class="nav-link" href={href} aria-current={path === href ? 'page' : undefined}>
            {label}
          </a>
        ),
      )
    }
    <a class="btn btn-primary nav-cta" href="/request-access">Request access</a>
    <span class="nav-break" aria-hidden="true"></span>
  </nav>
</header>

<script>
  const menus = [...document.querySelectorAll<HTMLElement>('.menu')];

  /** Shut every menu: the tap-opened state and the picked-while-hovered one. */
  const closeAll = (except?: HTMLElement) => {
    for (const menu of menus) {
      if (menu === except) continue;
      menu.classList.remove('is-open');
    }
  };

  for (const menu of menus) {
    const label = menu.querySelector<HTMLAnchorElement>('.nav-link');

    // A touch screen has no hover, so the menu would never open. The first tap
    // opens it instead of following the link; a second tap on the same label
    // goes through to the page. Pointer devices keep the hover behaviour and
    // never reach this.
    label?.addEventListener('click', (event) => {
      if (!window.matchMedia('(hover: none)').matches) return;
      if (menu.classList.contains('is-open')) return;
      event.preventDefault();
      closeAll();
      menu.classList.remove('is-closed');
      menu.classList.add('is-open');
    });

    // Moving off the menu resets both states, so hover works normally again.
    menu.addEventListener('mouseleave', () => {
      menu.classList.remove('is-closed', 'is-open');
    });
  }

  // A tap anywhere else dismisses an open menu.
  document.addEventListener('click', (event) => {
    if (!(event.target as Element | null)?.closest?.('.menu')) closeAll();
  });

  /**
   * A menu pick for the page you are already on: keep the page, hand the
   * selection to its panel. Anywhere else the link navigates normally.
   */
  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((link) => {
    link.addEventListener('click', (event) => {
      // Close the menu either way — on a same-page pick nothing else would,
      // and on a navigation it should not sit open through the page fade.
      const menu = link.closest<HTMLElement>('.menu');
      menu?.classList.remove('is-open');
      menu?.classList.add('is-closed');
      (document.activeElement as HTMLElement | null)?.blur?.();

      const { pick, pickHash, pickIndex, pickPath } = link.dataset;
      if (!pick || !pickHash || !pickIndex || !pickPath) return;

      const here = location.pathname.replace(/\/$/, '') || '/';
      if (here !== pickPath) return;

      event.preventDefault();
      const index = Number(pickIndex);
      try {
        history.replaceState(null, '', `#${pickHash}-${index}`);
      } catch {
        /* a blocked history write must not stop the selection */
      }
      window.dispatchEvent(new CustomEvent(pick, { detail: index }));
    });
  });
</script>

<style>
  .nav-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    padding: 18px 32px;
    border-bottom: 2px solid var(--color-divider);
    flex: none;
    background: var(--color-bg);
  }

  .brand {
    display: flex;
    align-items: baseline;
    gap: 10px;
    color: var(--color-text);
    text-decoration: none;
    flex: none;
  }

  .brand-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .brand-tag {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-neutral-600);
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    justify-content: flex-end;
    gap: clamp(12px, 2.2vw, 28px);
  }

  /* Scoped to .nav-link, not to "every a in the nav". A :not() chain broad
     enough to cover both would also outrank .menu-panel a:hover on
     specificity, which paints the hovered menu item accent-on-accent. */
  .nav-link {
    font-size: clamp(13px, 1.25vw, 15px);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-accent);
  }

  /* The vertical padding bridges the gap to the panel, so moving the pointer
     from the label onto the menu never crosses dead space and closes it. */
  .menu {
    position: relative;
    padding: 20px 0;
    margin: -20px 0;
  }

  .menu-panel {
    position: absolute;
    top: 100%;
    left: -18px;
    /* Never wider than the window, or the panel hangs off a narrow one. */
    width: min(336px, calc(100vw - 40px));
    display: none;
    background: var(--color-bg);
    border: 2px solid var(--color-divider);
    border-top: 0;
    z-index: 20;
    box-shadow: var(--shadow-md);
  }

  /* focus-within keeps the menu reachable by keyboard, and .is-open by tap on a
     touch screen, neither of which the hover-only source could do. */
  .menu:hover .menu-panel,
  .menu:focus-within .menu-panel,
  .menu.is-open .menu-panel {
    display: block;
  }

  /* Set when an item is picked, so the menu closes under a pointer that is
     still resting on it. Cleared on mouseleave. Must follow the rules above:
     same specificity, so it wins on source order. */
  .menu.is-closed .menu-panel {
    display: none;
  }

  .menu-panel a {
    display: block;
    padding: 14px 18px;
    text-decoration: none;
    color: var(--color-text);
  }

  .menu-panel a + a {
    border-top: 2px solid var(--color-divider);
  }

  .menu-panel a:hover,
  .menu-panel a:focus-visible {
    background: var(--color-accent);
    color: var(--color-neutral-100);
  }

  .menu-title {
    display: block;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: -0.01em;
  }

  .menu-blurb {
    display: block;
    font-size: 12px;
    line-height: 1.4;
    color: currentColor;
    opacity: 0.7;
    margin-top: 3px;
  }

  .nav-cta {
    padding: 9px 14px;
    font-size: 12px;
    white-space: nowrap;
  }

  /* Only exists to end the first row once the nav wraps; see the query below. */
  .nav-break {
    display: none;
  }

  /* Below this the nav becomes two rows — brand, then the links — rather than
     one crowded one. It must not drop the links instead: Services, Science and
     Company are the site's content, and hiding them here strands a phone on
     whichever page it landed on. */
  @media (max-width: 760px) {
    .nav-bar {
      flex-wrap: wrap;
      justify-content: flex-start;
      padding: 14px 20px;
      gap: 12px 18px;
    }

    /* display: contents dissolves the nav's own box so the brand, the links and
       the button all become items of the same flex row and can be ordered
       across two lines: brand and button first, links beneath. The <nav>
       landmark itself is unaffected. */
    .nav-links {
      display: contents;
    }

    /* Flex breaks lines before it shrinks items, so an un-capped brand would
       keep the tag beside the name and push the button onto a row of its own.
       Capping it to the room the button leaves makes the tag wrap under the
       name instead — it stays visible, and the nav stays two rows. */
    .brand {
      order: 1;
      flex-wrap: wrap;
      row-gap: 2px;
      max-width: calc(100% - 140px);
    }

    .nav-cta {
      order: 2;
      margin-left: auto;
      padding: 8px 12px;
      font-size: 11px;
    }

    /* A full-width, zero-height item: flexbox has no "break here", so this
       closes the brand row and drops the links onto their own. */
    .nav-break {
      display: block;
      order: 3;
      flex-basis: 100%;
      height: 0;
    }

    .menu,
    .nav-link {
      order: 4;
      font-size: 12px;
    }

    /* Anchored to the nav bar rather than to the label: the labels sit on the
       second row, and a panel hung off the right-hand one would run past the
       edge of a phone. Dropping it under the whole bar also gives it the full
       width to use. */
    .menu {
      position: static;
      /* The panel hangs off the bottom of the bar, so the bar's own bottom
         padding sits between the label and it. Without this the pointer
         crosses un-hovered ground on the way down and the menu shuts before
         it can be reached. The negative margin keeps the row's height. */
      padding: 0 0 16px;
      margin: 0 0 -16px;
    }

    .menu-panel {
      left: 20px;
      right: 20px;
      width: auto;
    }
  }
</style>
